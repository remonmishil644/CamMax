<resources>
    <style name="Theme.CamMax" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorOnPrimary">@color/on_green</item>
        <item name="colorPrimaryContainer">@color/green_container</item>
        <item name="colorOnPrimaryContainer">@color/on_green_container</item>
        <item name="colorSecondary">@color/green</item>
        <item name="colorOnSecondary">@color/on_green</item>
        <item name="colorSecondaryContainer">@color/green_container</item>
        <item name="colorOnSecondaryContainer">@color/on_green_container</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="colorSurfaceVariant">@color/surface_high</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_highest</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_soft</item>
        <item name="colorError">@color/red</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="CamMax.Section" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="CamMax.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeColor">@color/outline_soft</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
