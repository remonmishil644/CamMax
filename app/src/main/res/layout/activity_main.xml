<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:clipToPadding="false">

    <LinearLayout
        android:orientation="vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="20dp" android:paddingBottom="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="CamMax"
                android:textSize="28sp"
                android:textColor="@color/text"
                android:fontFamily="sans-serif-medium"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" />

            <TextView android:id="@+id/statePill"
                android:text="Ready"
                android:textSize="13sp"
                android:textColor="@color/text"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/pill"
                android:drawableStart="@drawable/dot"
                android:drawablePadding="8dp"
                android:paddingStart="12dp" android:paddingEnd="14dp"
                android:paddingTop="7dp" android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Summary -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CamMax.Card"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView android:id="@+id/summaryBig"
                    android:textSize="36sp"
                    android:textColor="@color/text"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView android:id="@+id/summarySub"
                    android:textSize="14sp"
                    android:textColor="@color/text_dim"
                    android:layout_marginTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:background="@color/outline_soft"
                    android:layout_marginTop="16dp" android:layout_marginBottom="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <TextView android:id="@+id/storageText"
                    android:textSize="14sp"
                    android:textColor="@color/text"
                    android:fontFeatureSettings="tnum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView android:id="@+id/lastText"
                    android:textSize="13sp"
                    android:textColor="@color/text_dim"
                    android:lineSpacingMultiplier="1.25"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Warning (hidden unless needed) -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/warnCard"
            style="@style/CamMax.Card"
            app:cardBackgroundColor="@color/amber_container"
            app:strokeColor="@color/amber"
            android:visibility="gone"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView android:id="@+id/warnText"
                    android:textSize="14sp"
                    android:textColor="@color/text"
                    android:lineSpacingMultiplier="1.25"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton android:id="@+id/warnBtn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Lens -->
        <TextView style="@style/CamMax.Section" android:text="Lens"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/lensChips"
            app:singleSelection="true" app:selectionRequired="true"
            app:chipSpacingHorizontal="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <!-- Resolution -->
        <TextView style="@style/CamMax.Section" android:text="Resolution"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/sizeChips"
            app:singleSelection="true" app:selectionRequired="true"
            app:chipSpacingHorizontal="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <!-- Frame rate -->
        <TextView style="@style/CamMax.Section" android:text="Frame rate"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/fpsChips"
            app:singleSelection="true" app:selectionRequired="true"
            app:chipSpacingHorizontal="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/fpsNote"
            android:textSize="13sp"
            android:textColor="@color/text_dim"
            android:lineSpacingMultiplier="1.25"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <!-- Stabilization -->
        <TextView style="@style/CamMax.Section" android:text="Stabilization"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/stabChips"
            app:singleSelection="true" app:selectionRequired="true"
            app:chipSpacingHorizontal="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/stabNote"
            android:textSize="13sp"
            android:textColor="@color/text_dim"
            android:lineSpacingMultiplier="1.25"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton android:id="@+id/walkBtn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:text="Apply walking preset"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView
            android:text="Sets the ultrawide lens, the strongest stabilization, and 60 fps. A wide view hides footstep shake best."
            android:textSize="13sp"
            android:textColor="@color/text_dim"
            android:lineSpacingMultiplier="1.25"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <!-- Quality -->
        <TextView style="@style/CamMax.Section" android:text="Quality"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <com.google.android.material.card.MaterialCardView
            style="@style/CamMax.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="vertical"
                android:paddingStart="20dp" android:paddingEnd="20dp"
                android:paddingTop="16dp" android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView android:id="@+id/bitrateLabel"
                    android:textSize="15sp"
                    android:textColor="@color/text"
                    android:fontFeatureSettings="tnum"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />

                <com.google.android.material.slider.Slider android:id="@+id/bitrateSlider"
                    android:contentDescription="Video bitrate"
                    android:valueFrom="10" android:valueTo="300" android:stepSize="5"
                    app:labelBehavior="gone"
                    app:tickVisible="false"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/gyroSwitch"
                    android:text="Save motion data for Gyroflow"
                    android:textSize="15sp"
                    android:minHeight="56dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/hevcSwitch"
                    android:text="HEVC (files half the size of H.264)"
                    android:textSize="15sp"
                    android:minHeight="56dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Test -->
        <com.google.android.material.button.MaterialButton android:id="@+id/testBtn"
            android:text="Test these settings (10 s)"
            android:textSize="15sp"
            android:minHeight="56dp"
            app:cornerRadius="16dp"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView
            android:text="Records 10 seconds, saves the clip, and shows the frame rate the camera really delivered."
            android:textSize="13sp"
            android:textColor="@color/text_dim"
            android:lineSpacingMultiplier="1.25"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <!-- Advanced -->
        <com.google.android.material.button.MaterialButton android:id="@+id/advancedBtn"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="Show advanced"
            android:minHeight="48dp"
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />

        <LinearLayout android:id="@+id/advancedBox"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                style="@style/CamMax.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView android:id="@+id/isoLabel"
                        android:textSize="15sp"
                        android:textColor="@color/text"
                        android:fontFeatureSettings="tnum"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />

                    <com.google.android.material.slider.Slider android:id="@+id/isoSlider"
                        android:contentDescription="Manual ISO"
                        android:valueFrom="0" android:valueTo="3200" android:stepSize="50"
                        app:labelBehavior="gone"
                        app:tickVisible="false"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:hint="Custom frame rate"
                        app:helperText="Overrides the chips above. Leave empty for normal use."
                        android:layout_marginTop="12dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/customFps"
                            android:inputType="number" android:maxLength="3"
                            android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton android:id="@+id/logBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:text="Event log"
                    android:minHeight="48dp"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton android:id="@+id/infoBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:text="Camera info"
                    android:minHeight="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/copyBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:text="Copy to clipboard"
                android:visibility="gone"
                android:minHeight="48dp"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" />

            <TextView android:id="@+id/monoText"
                android:visibility="gone"
                android:textIsSelectable="true"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/text_dim"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- How to -->
        <TextView
            android:text="Tap the green-dot CamMax REC icon to start. Tap it again to stop.\nLong buzz: recording started.\nShort buzz: stopped and saved.\nThree short buzzes: error. Open CamMax to read it.\nClips are 2 minutes long and save to DCIM/CamMax."
            android:textSize="13sp"
            android:textColor="@color/text_dim"
            android:lineSpacingMultiplier="1.35"
            android:layout_marginTop="28dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
